# Wzór pliku sekretów na VM Oracle. Nie commituj uzupełnionej kopii.
#
# Jednorazowo, po zalogowaniu jako opc:
#   mkdir -p /home/opc/secrets
#   chmod 700 /home/opc/secrets
#   cp infra/oci/fishing.env.example /home/opc/secrets/fishing.env
#   openssl rand -base64 48
#   chmod 600 /home/opc/secrets/fishing.env
#
# JWT_SECRET wklej jako jedną linię (wynik openssl, minimum 32 znaki).
# Jeśli /home/opc/app/.env już działa, wystarczy go przenieść:
#   mv /home/opc/app/.env /home/opc/secrets/fishing.env && chmod 600 /home/opc/secrets/fishing.env
# Deploy i tak przeniesie stary plik przy pierwszym uruchomieniu, o ile nowego jeszcze nie ma.

JWT_SECRET=replace-with-openssl-rand-base64-48

# Hasło konta postgres w kontenerze. Przy już istniejącej bazie zostaw to hasło,
# którym wolumen został utworzony (domyślnie postgres). Sama zmiana tej linii
# nie przestawia hasła w istniejącym wolumenie.
#POSTGRES_PASSWORD=postgres

# Opcjonalnie (aplikacja ma własne domyślne wartości):
#JWT_EXPIRES_IN=15m
#REFRESH_TOKEN_DAYS=30
#CORS_ORIGIN=
#TRUST_PROXY_HOPS=1
#PG_POOL_MAX=8
#HSTS_MAX_AGE=0
