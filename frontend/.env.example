# Zmienne są wbudowywane w bundle podczas `vite build` (prefiks VITE_).
# Domyślnie frontend używa ścieżek względnych (/api, /socket.io) i oczekuje,
# że nginx / load balancer skieruje je na backend. Nadpisz tylko gdy API jest na innej domenie.
#VITE_API_URL=https://api.aaa.domen.pl/api
#VITE_SOCKET_URL=https://api.aaa.domen.pl

# Tylko dev: dokąd Vite ma proxować /api i /socket.io
#VITE_DEV_BACKEND_URL=http://localhost:5000
