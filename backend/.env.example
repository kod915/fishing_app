# --- wymagane ---
PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fishing_db
# min. 32 znaki; w produkcji brak tej wartości przerywa start aplikacji
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# --- opcjonalne ---
# NODE_ENV=production włącza: TLS do bazy, wymóg JWT_SECRET, Secure cookie, blokadę seedów
#NODE_ENV=production

# Czas życia JWT (access token). Sesja jest przedłużana refresh tokenem w cookie HttpOnly.
#JWT_EXPIRES_IN=15m
#REFRESH_TOKEN_DAYS=30

# Dozwolone originy frontendu (CSV). Tylko dla dev-serwera Vite; w produkcji za nginx
# frontend jest na tym samym origin – zostaw puste.
CORS_ORIGIN=http://localhost:5173

# Redis: adapter Socket.IO i współdzielony rate limiter. Wymagane przy >1 instancji backendu.
#REDIS_URL=redis://localhost:6379

# Liczba warstw reverse proxy przed aplikacją (poprawne req.ip dla rate limitera).
# Docker Compose (nginx): 1. Azure Container Apps (ingress + nginx): 2. Z Front Door: 3.
#TRUST_PROXY_HOPS=1

# Pula połączeń do bazy: replik x PG_POOL_MAX < max_connections serwera
#PG_POOL_MAX=8
# Ścieżka do bundla CA, jeśli Node nie zna certyfikatu serwera PostgreSQL
#PG_SSL_CA=/etc/ssl/certs/azure-postgres-ca.pem
# TLS do bazy jest włączone automatycznie w produkcji. PG_SSL=disable wyłącznie dla
# lokalnego docker-compose (baza bez certyfikatu w tej samej sieci) – nigdy w chmurze.
#PG_SSL=disable
