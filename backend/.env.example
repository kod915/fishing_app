PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fishing_db
JWT_SECRET=super_secret_key_change_me

# Dozwolone originy frontendu (CSV). Lokalnie Vite (5173); w chmurze np. https://aaa.domen.pl
CORS_ORIGIN=http://localhost:5173

# Opcjonalnie: Redis do rozgłaszania wiadomości Socket.IO między instancjami backendu.
# Wymagane, gdy backend działa w więcej niż jednej replice (autoscaling za load balancerem).
#REDIS_URL=redis://localhost:6379

# Liczba warstw reverse proxy przed aplikacją (load balancer, nginx) – domyślnie 1
#TRUST_PROXY_HOPS=1
