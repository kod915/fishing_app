{
  "name": "fishing-app-backend",
  "version": "1.1.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node-pg-migrate up -m db/migrations --migration-file-language sql",
    "db:migrate:down": "node-pg-migrate down -m db/migrations --migration-file-language sql",
    "db:seed": "node db/seedUsers.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.11.5",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
